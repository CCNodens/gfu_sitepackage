mod {
  web_layout {
    BackendLayouts {
      footer {
        title = 'Footer Backend Layout'
        config {
          backend_layout {
            colCount = 3
            rowCount = 1
            rows {
              1 {
                columns {
                  1 {
                    name = LLL:EXT:gfu_sitepackage/Resources/Private/Language/locallang.xlf:footer_left
                    colPos = 2
                  }
                  2 {
                    name = LLL:EXT:gfu_sitepackage/Resources/Private/Language/locallang.xlf:footer_center
                    colPos = 3
                  }
                  3 {
                    name = LLL:EXT:gfu_sitepackage/Resources/Private/Language/locallang.xlf:footer_right
                    colPos = 4
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
