page = PAGE
page {
    config {
        absRefPrefix = /
        htmlTag_langKey = de
        doctype = html5
        metaCharset = utf-8
        renderCharset = utf-8
        removeDefaultJS = 1w
        removePageCss = 0
        removeDefaultCss = 1
        removeDefaultJS = external
        sendCacheHeaders = 1
        disablePrefixComment = 1
        meaningfulTempFilePrefix = 100
        typolinkCheckRootline = 1
        typolinkEnableLinksAcrossDomains = 1
        spamProtectEmailAddresses = 1
        spamProtectEmailAddresses_atSubst = <span>@</span>
        language = de
        locale_all = de_DE.utf-8
        concatenateJs = 0
        compressJs = 1
        concatenateCss = 1
        compressCss = 1
        minifyCSS = 0
        htmlTag_stdWrap {
            setContentToCurrent = 1
            cObject = COA
            cObject {
                10 = TEXT
                10 {
                    addParams {
                        class = no-js
                    }
                    # append a line feed for some reason
                    append = TEXT
                    append {
                        char = 10
                    }
                    current = 1
                }
            }
        }
    }

    meta {
        viewport = width=device-width, initial-scale=1, user-scalable=yes, shrink-to-fit=no
        language = de
    }

    includeCSS {
        01_mainstylesheet = EXT:gfu_sitepackage/Resources/Public/Css/main.css
    }

    includeJS {
        # include javascript resource into <head>
    }

    includeJSFooterlibs {
        #jquery = EXT:core/Resources/Public/JavaScript/Contrib/jquery/jquery.js
        scripts = EXT:gfu_sitepackage/Resources/Public/Js/scripts.js
    }
}

page.10 = FLUIDTEMPLATE
page.10 {
    file.stdWrap.cObject = CASE
    file.stdWrap.cObject {
        key.data = levelfield:-2,backend_layout_next_level,slide
        key.override.field = backend_layout

        pagets__startpage = TEXT
        pagets__startpage {
            value = {$plugin.tx_gfusitepackage.view.templateRootPath}Page/Startpage.html
        }

        pagets__subpage = TEXT
        pagets__subpage {
            value = {$plugin.tx_gfusitepackage.view.templateRootPath}Page/Subpage.html
        }

        pagets__footer = TEXT
        pagets__footer {
            value = {$plugin.tx_gfusitepackage.view.templateRootPath}Page/Footer.html
        }
    }

    settings {
        startPagePid = {$plugin.tx_gfusitepackage.settings.startPagePid}
        siteLogo = {$plugin.tx_gfusitepackage.settings.siteLogo}
        footerNavigationPid = {$plugin.tx_gfusitepackage.settings.footerNavigationPid}
    }

    format = html
    partialRootPath = {$plugin.tx_gfusitepackage.view.partialRootPath}
    layoutRootPath = {$plugin.tx_gfusitepackage.view.layoutRootPath}

    variables {
        myTemplateVars = COA
        myTemplateVars {
            10 = TEXT
            10.value = simple template var
            20 = TEXT
            20.value = annother simple template var
        }
    }

    dataProcessing {
        10 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
        10 {
            levels = 2
            titleField = nav_title // title
            expandAll = 1
            as = mainNavigation
            dataProcessing {
                10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
                10 {
                    references.fieldName = media
                    as = images
                }
            }
        }

        20 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
        20 {
            special = directory
            special.value = {$plugin.tx_gfusitepackage.settings.metaNavigationPid}
            as = metaNavigation
            dataProcessing {
                10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
                10 {
                    references.fieldName = media
                }
            }
        }

        30 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
        30 {
            special = directory
            special.value = {$plugin.tx_gfusitepackage.settings.footerNavigationPid}
            as = footerNavigation
        }
    }
}

# Conditional TypoScript block.
# code inside brackets overrides any previously defined properties
# will not work inside nested TypoScript notation!
[applicationContext == "Testing" || applicationContext == "Development"]
    config {
        no_cache = 0
        contentObjectExceptionHandler = 0
        concatenateJs = 0
        compressJs = 0
        concatenateCss = 0
        compressCss = 0
        minifyCSS = 0
    }
[global]

