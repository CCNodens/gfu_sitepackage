{
  "name": "vancado/vnc-powermailratelimiter",
  "type": "typo3-cms-extension",
  "description": "Powermail rate limiter",
  "license": "GPL-2.0-or-later",
  "version": "13.4.1",
  "require": {
    "typo3/cms-core": "^13.4",
    "in2code/powermail": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Vancado\\VncPowermailratelimiter\\": "Classes/"
    }
  },
  "replace": {
    "vancado/vnc-powermailratelimiter": "self.version"
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "vnc_powermailratelimiter"
    }
  }
}