{
  "name": "vancado/vnc-news",
  "description": "Import posts from WP to news records. Support img tags in RTE. Additional ajax list view for TYPO3 News",
  "type": "typo3-cms-extension",
  "version": "13.4.2",
  "license": [
    "GPL-2.0-or-later"
  ],
  "require": {
    "typo3/cms-core": "^13.4",
    "php": ">=8.2",
    "ext-simplexml": "*",
    "ext-dom": "*",
    "georgringer/news": "^12.3",
    "georgringer/numbered-pagination": "^2.1",
    "internetgalerie/ig-slug": "^1.1"
  },
  "autoload": {
    "psr-4": {
      "Vancado\\VncNews\\": "Classes/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "vnc_news"
    }
  }
}